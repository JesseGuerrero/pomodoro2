{
  "identifier": "default",
  "description": "Default capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-show",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://www.googleapis.com/*" }, { "url": "http://gtfs.viainfo.net/*" }]
    }
  ]
}
